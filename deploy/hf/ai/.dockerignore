# Keep the Space image (and repo) lean and secret-free. The assemble script
# already filters these, but this is a second guard for `docker build`.
**/.git
**/.env
**/.env.*
**/__pycache__
**/*.py[cod]
**/.venv
**/venv
**/env
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/chroma_db
**/.asra_cache
**/logs/*.jsonl
**/intake_sessions/*.json
**/node_modules
**/.DS_Store
**/tests
