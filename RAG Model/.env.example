GEMINI_API_KEY=
ASRA_GENERATION_MODEL=gemini-2.5-flash-lite
ASRA_EMBEDDING_MODEL=gemini-embedding-001
ASRA_CHROMA_PATH=./chroma_db
ASRA_KB_PATH=./kb
ASRA_LLM_AUDIT_LOG=./logs/llm_audit.jsonl

# --- Token / retrieval tuning (all optional) ---
# Disable model "thinking" on the narrow LLM tasks (default 0 = off; thinking
# tokens bill at the 4x output rate). Raise to allow a thinking budget.
# ASRA_THINKING_BUDGET=0
# Trim retrieved context before it is billed as generation input tokens.
# ASRA_MAX_CONTEXT_CHUNKS=6      # global top-N chunks per LLM call (was up to 13)
# ASRA_MAX_CHUNK_CHARS=1200      # truncate each rendered chunk (~300 tokens)
# Embedding retrieval tuning — asymmetric task_type + smaller MRL vectors.
# Changes the embedding space, so ACTIVATE TOGETHER WITH A REBUILD:
#   ASRA_EMBED_TUNED=1 asra-matcher ingest --rebuild
# ASRA_EMBED_TUNED=0             # 1 = enable RETRIEVAL_QUERY/DOCUMENT + output dim
# ASRA_EMBED_DIM=768             # MRL output dimensionality when tuned (128-3072)
